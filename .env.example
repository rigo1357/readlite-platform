# Giá trị chỉ dành cho môi trường local; không dùng các giá trị này khi triển khai.
WEB_PORT=8080
API_PORT=3000
MAILPIT_HTTP_PORT=8025
MAILPIT_SMTP_PORT=1025
POSTGRES_DB=readlite
POSTGRES_USER=readlite
POSTGRES_PASSWORD=readlite_local
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
COOKIE_SECURE=false
# Kho media tùy chọn; để ngoài thư mục dự án. Docker Compose dùng volume bền vững riêng.
# READLITE_MEDIA_DIR=C:/Users/<you>/.readlite/media

# Email tùy chọn. Không cấu hình SMTP_HOST: dùng token/link trong log ở môi trường phát triển.
# APP_PUBLIC_URL là origin API mà người nhận email truy cập được, không phải URL Android emulator.
# Local API + Mailpit: SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_SECURE=false
# Docker API + Mailpit: SMTP_HOST=mailpit, SMTP_PORT=1025, SMTP_SECURE=false
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_FROM=readlite@example.test
# APP_PUBLIC_URL=http://localhost:3000
# Nhà cung cấp thật: cấu hình user/password theo dịch vụ; production dùng HTTPS và TLS.
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password

# Optional AI-assisted story review. Configure only after choosing a provider.
# When enabled, chapter text chunks are sent to this provider for review.
# The provider only returns warnings; an administrator still decides publication.
# AI_REVIEW_PROVIDER=openai-compatible
# AI_REVIEW_API_URL=https://api.openai.com/v1/chat/completions
# AI_REVIEW_API_KEY=your-api-key
# AI_REVIEW_MODEL=your-approved-model
# Defaults when omitted: timeout 45000ms, chunk 10000 characters, 5 attempts,
# 120-second lease, 10-second retry base and 3000ms polling interval.
