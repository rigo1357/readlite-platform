<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <FrameLayout android:layout_width="match_parent" android:layout_height="220dp" android:background="@drawable/bg_story_cover_placeholder">
        <ImageView android:id="@+id/story_card_cover" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:background="@drawable/bg_story_cover_placeholder" android:clipToOutline="true" android:visibility="gone" android:importantForAccessibility="no"/>
        <TextView android:id="@+id/story_card_cover_placeholder" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="bottom" android:padding="12dp" android:maxLines="5" android:ellipsize="end" android:textColor="#FFFFFF"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/story_card_favorite" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top|end" android:layout_margin="4dp" android:backgroundTint="@color/readlite_surface" android:focusable="false" android:minWidth="0dp" android:padding="0dp" android:text="♡" android:textColor="@color/readlite_taupe_dark" android:textSize="22sp" app:cornerRadius="24dp"/>
    </FrameLayout>
    <TextView style="@style/Widget.ReadLite.Label" android:text="" android:id="@+id/story_card_title" android:layout_marginTop="8dp" android:maxLines="2" android:minLines="2" android:ellipsize="end"/>
    <TextView style="@style/Widget.ReadLite.Body" android:text="" android:id="@+id/story_card_author" android:maxLines="1" android:ellipsize="end" android:textSize="11sp"/>
    <TextView style="@style/Widget.ReadLite.Body" android:text="" android:id="@+id/story_card_genres" android:maxLines="1" android:ellipsize="end" android:textSize="10sp" android:layout_marginTop="3dp"/>
    <TextView style="@style/Widget.ReadLite.Body" android:text="" android:id="@+id/story_card_metadata" android:maxLines="1" android:ellipsize="end" android:textSize="10sp" android:layout_marginTop="3dp"/>
    <TextView style="@style/Widget.ReadLite.Body" android:text="" android:id="@+id/story_card_progress" android:maxLines="2" android:textSize="10sp" android:layout_marginTop="4dp" android:visibility="gone"/>
</LinearLayout>
