<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/password_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/readlite_paper"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/password_back"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/action_back"
            android:textAllCaps="false" />
        <TextView android:id="@+id/password_title" style="@style/Widget.ReadLite.Title"
            android:layout_marginTop="24dp" android:textSize="28sp" />
        <TextView android:id="@+id/password_subtitle" style="@style/Widget.ReadLite.Body"
            android:layout_marginTop="10dp" android:layout_marginBottom="28dp" />
        <LinearLayout android:id="@+id/password_email_fields"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView style="@style/Widget.ReadLite.Label" android:text="@string/password_email_label"
                android:labelFor="@id/password_email" />
            <EditText android:id="@+id/password_email" style="@style/Widget.ReadLite.Field"
                android:hint="@string/password_email_hint" android:inputType="textEmailAddress"
                android:autofillHints="emailAddress" android:imeOptions="actionDone"
                android:maxLength="254" android:layout_marginBottom="16dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/password_token_fields"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView style="@style/Widget.ReadLite.Label" android:text="@string/password_token_label"
                android:labelFor="@id/password_reset_token" />
            <EditText android:id="@+id/password_reset_token" style="@style/Widget.ReadLite.Field"
                android:hint="@string/password_token_hint" android:inputType="textVisiblePassword"
                android:importantForAutofill="no" android:saveEnabled="false"
                android:imeOptions="actionNext" android:layout_marginBottom="16dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/password_current_fields"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView style="@style/Widget.ReadLite.Label" android:text="@string/password_current_label"
                android:labelFor="@id/password_current" />
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:endIconMode="password_toggle" app:hintEnabled="false" app:boxBackgroundMode="none"
                android:layout_marginBottom="16dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/password_current"
                    style="@style/Widget.ReadLite.Field" android:inputType="textPassword"
                    android:hint="@string/password_current_hint" android:saveEnabled="false"
                    android:importantForAutofill="no" android:imeOptions="actionNext" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/password_new_fields"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView style="@style/Widget.ReadLite.Label" android:text="@string/password_new_label"
                android:labelFor="@id/password_new" />
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:endIconMode="password_toggle" app:hintEnabled="false" app:boxBackgroundMode="none">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/password_new"
                    style="@style/Widget.ReadLite.Field" android:inputType="textPassword"
                    android:hint="@string/password_new_hint" android:saveEnabled="false"
                    android:importantForAutofill="no" android:imeOptions="actionNext" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView style="@style/Widget.ReadLite.Body" android:text="@string/password_requirement"
                android:layout_marginTop="6dp" android:layout_marginBottom="16dp" android:textSize="12sp" />
            <TextView style="@style/Widget.ReadLite.Label" android:text="@string/password_confirm_label"
                android:labelFor="@id/password_confirm" />
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:endIconMode="password_toggle" app:hintEnabled="false" app:boxBackgroundMode="none">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/password_confirm"
                    style="@style/Widget.ReadLite.Field" android:inputType="textPassword"
                    android:hint="@string/password_confirm_hint" android:saveEnabled="false"
                    android:importantForAutofill="no" android:imeOptions="actionDone" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/password_submit"
            style="@style/Widget.ReadLite.Primary" android:layout_width="match_parent"
            android:layout_height="52dp" android:layout_marginTop="24dp" />
        <TextView android:id="@+id/password_status" style="@style/Widget.ReadLite.Body"
            android:accessibilityLiveRegion="polite" android:layout_marginTop="16dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/password_switch_mode"
            style="@style/Widget.ReadLite.Secondary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="16dp" />
    </LinearLayout>
</ScrollView>
