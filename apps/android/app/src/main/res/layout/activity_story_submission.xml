<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/story_submission_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/readlite_paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/story_submission_back"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:text="@string/reader_back"
                android:textAllCaps="false"
                android:textColor="@color/readlite_ink" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end|center_vertical"
                android:text="READLITE · TÁC GIẢ"
                android:textColor="@color/readlite_muted"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/story_submission_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:minHeight="38dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/readlite_muted"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/story_submission_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/story_submission_cancel_upload"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hủy tải lên"
            android:textAllCaps="false"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/story_submission_list_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Truyện của tôi"
                android:textColor="@color/readlite_ink"
                android:textSize="28sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/readlite_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/readlite_line"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nhập một hoặc nhiều EPUB"
                        android:textColor="@color/readlite_ink"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:lineSpacingExtra="3dp"
                        android:text="Có thể chọn nhiều tệp cùng lúc (tối đa 20). Mỗi EPUB được lưu thành bản nháp riêng để kiểm tra trước khi gửi duyệt."
                        android:textColor="@color/readlite_muted"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/story_submission_import_button"
                        android:layout_width="match_parent"
                        android:layout_height="49dp"
                        android:layout_marginTop="13dp"
                        android:backgroundTint="@color/readlite_taupe"
                        android:text="Chọn một hoặc nhiều EPUB"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        app:cornerRadius="14dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Danh sách truyện"
                android:textColor="@color/readlite_ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/story_submission_batch_submit"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gửi duyệt các bản nháp đã chọn"
                android:textAllCaps="false"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/story_submission_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/story_submission_editor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Xem trước bản nháp"
                android:textColor="@color/readlite_ink"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Kiểm tra thông tin và hình ảnh trước khi gửi duyệt."
                android:textColor="@color/readlite_muted"
                android:textSize="13sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/readlite_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/readlite_line"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="15dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Thông tin truyện"
                        android:textColor="@color/readlite_ink"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/story_submission_title"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_readlite_input"
                        android:hint="Tên truyện"
                        android:inputType="textCapSentences"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:singleLine="true"
                        android:textColor="@color/readlite_ink"
                        android:textColorHint="@color/readlite_muted" />

                    <EditText
                        android:id="@+id/story_submission_author"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="9dp"
                        android:background="@drawable/bg_readlite_input"
                        android:hint="Tác giả"
                        android:inputType="textCapWords"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:singleLine="true"
                        android:textColor="@color/readlite_ink"
                        android:textColorHint="@color/readlite_muted" />

                    <EditText
                        android:id="@+id/story_submission_language"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="9dp"
                        android:background="@drawable/bg_readlite_input"
                        android:hint="Ngôn ngữ, ví dụ vi"
                        android:inputType="text"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:singleLine="true"
                        android:textColor="@color/readlite_ink"
                        android:textColorHint="@color/readlite_muted" />

                    <EditText
                        android:id="@+id/story_submission_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:background="@drawable/bg_readlite_input"
                        android:gravity="top|start"
                        android:hint="Giới thiệu truyện"
                        android:inputType="textCapSentences|textMultiLine"
                        android:minHeight="100dp"
                        android:padding="13dp"
                        android:textColor="@color/readlite_ink"
                        android:textColorHint="@color/readlite_muted" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/readlite_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/readlite_line"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <FrameLayout
                        android:layout_width="112dp"
                        android:layout_height="164dp"
                        android:background="@drawable/bg_story_cover_placeholder">

                        <ImageView
                            android:id="@+id/story_submission_cover"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_story_cover_placeholder"
                            android:clipToOutline="true"
                            android:contentDescription="Ảnh bìa truyện"
                            android:scaleType="centerCrop" />

                        <TextView
                            android:id="@+id/story_submission_cover_placeholder"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_story_cover_placeholder"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Chưa có ảnh bìa"
                            android:textColor="@android:color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="13dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Ảnh bìa"
                            android:textColor="@color/readlite_ink"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:lineSpacingExtra="2dp"
                            android:text="Dùng bìa lấy từ EPUB hoặc chọn ảnh riêng."
                            android:textColor="@color/readlite_muted"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/story_submission_cover_button"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Chọn ảnh bìa"
                            android:textAllCaps="false"
                            app:cornerRadius="13dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/story_submission_save_button"
                android:layout_width="match_parent"
                android:layout_height="49dp"
                android:layout_marginTop="13dp"
                android:backgroundTint="@color/readlite_taupe"
                android:text="Lưu thông tin"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                app:cornerRadius="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/story_submission_send_button"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="49dp"
                android:layout_marginTop="8dp"
                android:text="Gửi kiểm duyệt"
                android:textAllCaps="false"
                app:cornerRadius="14dp" />

            <TextView
                android:id="@+id/story_submission_preview_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textColor="@color/readlite_ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/story_submission_warnings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_readlite_input"
                android:padding="12dp"
                android:textColor="@color/readlite_ink"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/story_submission_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
