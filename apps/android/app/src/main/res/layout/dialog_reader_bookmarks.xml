<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
    android:paddingBottom="8dp">
    <TextView android:id="@+id/bookmark_list_status" style="@style/Widget.ReadLite.Body"
        android:accessibilityLiveRegion="polite" android:layout_marginBottom="12dp" />
    <ScrollView android:layout_width="match_parent" android:layout_height="280dp">
        <LinearLayout android:id="@+id/bookmark_list_rows"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
    <com.google.android.material.button.MaterialButton android:id="@+id/bookmark_list_more"
        style="@style/Widget.ReadLite.Secondary" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/bookmark_load_more"
        android:layout_marginTop="8dp" android:visibility="gone" />
</LinearLayout>
