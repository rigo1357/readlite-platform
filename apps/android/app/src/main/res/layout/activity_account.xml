<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/account_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/readlite_paper">
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
    <TextView style="@style/Widget.ReadLite.Title" android:text="Tài khoản" />
    <TextView android:id="@+id/account_avatar" android:layout_width="80dp" android:layout_height="80dp" android:layout_gravity="center_horizontal" android:layout_marginTop="28dp" android:background="@drawable/bg_readlite_brand" android:text="R" android:gravity="center" android:textSize="30sp" android:textColor="@color/readlite_taupe_dark" android:textStyle="bold"/>
    <TextView style="@style/Widget.ReadLite.Title" android:text="" android:id="@+id/account_identity" android:gravity="center" android:textSize="18sp" android:layout_marginTop="16dp" android:visibility="gone"/>
    <TextView style="@style/Widget.ReadLite.Body" android:text="@string/account_loading" android:id="@+id/account_status" android:gravity="center" android:accessibilityLiveRegion="polite" android:layout_marginTop="8dp" android:layout_marginBottom="26dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/account_sign_in_button" style="@style/Widget.ReadLite.Primary" android:layout_width="match_parent" android:layout_height="52dp" android:text="@string/account_sign_in" android:visibility="gone"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/account_edit_profile_button" style="@style/Widget.ReadLite.Secondary" android:layout_width="match_parent" android:layout_height="52dp" android:text="@string/profile_edit_button" android:visibility="gone" android:layout_marginBottom="8dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/account_change_password_button" style="@style/Widget.ReadLite.Secondary" android:layout_width="match_parent" android:layout_height="52dp" android:text="@string/password_change_button" android:visibility="gone" android:layout_marginBottom="8dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/account_open_bookshelf" style="@style/Widget.ReadLite.Secondary" android:layout_width="match_parent" android:layout_height="52dp" android:text="Tủ sách của tôi     ›" />
    <com.google.android.material.button.MaterialButton android:id="@+id/account_open_following" style="@style/Widget.ReadLite.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:text="Truyện đang theo dõi"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/account_open_notifications" style="@style/Widget.ReadLite.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:text="Thông báo chương mới"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/account_manage_stories_button" style="@style/Widget.ReadLite.Secondary" android:layout_width="match_parent" android:layout_height="52dp" android:text="Truyện của tôi · Nhập EPUB     ›" android:visibility="gone" android:layout_marginTop="8dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/account_review_queue_button" style="@style/Widget.ReadLite.Secondary" android:layout_width="match_parent" android:layout_height="52dp" android:text="Hàng đợi duyệt truyện     ›" android:visibility="gone" android:layout_marginTop="8dp"/>
    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/account_theme_switch" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="16dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:background="@drawable/bg_readlite_input" android:text="Giao diện tối" android:textColor="@color/readlite_ink"/>
    <TextView style="@style/Widget.ReadLite.Body" android:text="Một giao diện dịu mắt cho những giờ đọc sách." android:layout_marginTop="10dp" android:layout_marginBottom="28dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/account_sign_out_button" style="@style/Widget.ReadLite.Secondary" android:layout_width="match_parent" android:layout_height="52dp" android:text="Đăng xuất" android:visibility="gone"/>
    <Space android:layout_width="match_parent" android:layout_height="24dp" android:layout_weight="1"/>
    <TextView style="@style/Widget.ReadLite.Body" android:text="ReadLite · Không gian đọc của bạn" android:gravity="center" android:textSize="12sp" android:layout_marginTop="32dp"/>
</LinearLayout></ScrollView><View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/readlite_line"/><com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/account_bottom_navigation" style="@style/Widget.ReadLite.Navigation" app:menu="@menu/catalog_bottom_menu"/></LinearLayout>
