<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/home_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/readlite_paper">
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="20dp" android:paddingBottom="24dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20dp" android:paddingEnd="20dp" android:gravity="center_vertical">
        <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_readlite_book" android:importantForAccessibility="no"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView style="@style/Widget.ReadLite.Body" android:text="Chào mừng trở lại," /><TextView style="@style/Widget.ReadLite.Label" android:text="Bạn đọc ReadLite" android:id="@+id/home_greeting" android:textSize="17sp"/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/home_notifications" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="48dp" android:text="Thông báo" android:textAllCaps="false" android:textSize="12sp"/>
        <ImageButton android:id="@+id/home_account" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_readlite_brand" android:src="@drawable/ic_readlite_person" android:padding="12dp" android:contentDescription="Mở tài khoản"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="170dp" android:layout_margin="20dp" android:background="@drawable/bg_readlite_banner" android:gravity="center_vertical" android:padding="20dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mở sách.&#10;Mở thế giới." android:textColor="#FFFFFF" android:textSize="25sp" android:fontFamily="serif" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Một câu chuyện mới&#10;đang chờ bạn." android:textColor="#E8DFD1" android:textSize="12sp"/>
        </LinearLayout>
        <ImageView android:layout_width="120dp" android:layout_height="130dp" android:src="@drawable/reading_books" android:importantForAccessibility="no"/>
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/home_library_summary" style="@style/Widget.ReadLite.Secondary" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:text="Mở tủ sách của bạn     ›"/>
    <TextView style="@style/Widget.ReadLite.Body" android:text="Đang tải truyện…" android:id="@+id/home_status" android:accessibilityLiveRegion="polite" android:paddingStart="20dp" android:paddingEnd="20dp" android:layout_marginTop="12dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/home_retry" style="@style/Widget.ReadLite.Secondary" android:layout_width="match_parent" android:layout_height="52dp" android:text="Thử lại" android:visibility="gone" android:layout_marginStart="20dp" android:layout_marginEnd="20dp"/>
    <TextView style="@style/Widget.ReadLite.Title" android:text="Dành cho bạn" android:textSize="18sp" android:paddingStart="20dp" android:paddingEnd="20dp" android:layout_marginTop="24dp"/>
    <TextView android:id="@+id/home_recommendations_status" style="@style/Widget.ReadLite.Body" android:text="Đang chọn truyện cho bạn…" android:accessibilityLiveRegion="polite" android:textSize="12sp" android:paddingStart="20dp" android:paddingEnd="20dp" android:layout_marginTop="6dp" android:layout_marginBottom="14dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/home_recommendations_retry" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Thử lại gợi ý" android:textAllCaps="false" android:layout_marginStart="12dp" android:visibility="gone"/>
    <HorizontalScrollView android:id="@+id/home_recommendations_scroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:clipToPadding="false" android:paddingStart="20dp" android:paddingEnd="6dp"><LinearLayout android:id="@+id/home_recommendations_shelf" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"/></HorizontalScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20dp" android:paddingEnd="20dp" android:gravity="center_vertical" android:layout_marginTop="20dp">
        <TextView style="@style/Widget.ReadLite.Title" android:layout_width="0dp" android:layout_weight="1" android:textSize="18sp" android:text="Mới cập nhật"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/home_explore" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Xem tất cả" android:textAllCaps="false" android:textSize="12sp"/>
    </LinearLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:clipToPadding="false" android:paddingStart="20dp" android:paddingEnd="6dp"><LinearLayout android:id="@+id/home_newest_shelf" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"/></HorizontalScrollView>
    <TextView style="@style/Widget.ReadLite.Title" android:text="Được đọc nhiều" android:textSize="18sp" android:paddingStart="20dp" android:paddingEnd="20dp" android:layout_marginTop="26dp" android:layout_marginBottom="16dp"/>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:clipToPadding="false" android:paddingStart="20dp" android:paddingEnd="6dp"><LinearLayout android:id="@+id/home_popular_shelf" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"/></HorizontalScrollView>
</LinearLayout></ScrollView><View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/readlite_line"/><com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/home_bottom_navigation" style="@style/Widget.ReadLite.Navigation" app:menu="@menu/catalog_bottom_menu"/></LinearLayout>
