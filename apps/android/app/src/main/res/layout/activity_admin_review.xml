<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/admin_review_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/readlite_paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/admin_review_back"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reader_back"
                android:textAllCaps="false" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Hàng đợi duyệt"
                android:textColor="@color/readlite_ink"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/admin_review_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/readlite_muted"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/admin_review_bulk_approve"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Duyệt các truyện đã chọn"
            android:textAllCaps="false"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/admin_review_queue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/admin_review_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/admin_review_cover"
                android:layout_width="128dp"
                android:layout_height="184dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="Ảnh bìa truyện"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/admin_review_cover_placeholder"
                android:layout_width="128dp"
                android:layout_height="184dp"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:background="@color/readlite_surface"
                android:text="Chưa có ảnh bìa"
                android:textColor="@color/readlite_muted" />

            <TextView
                android:id="@+id/admin_review_story_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/readlite_ink"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/admin_review_story_metadata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:textColor="@color/readlite_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/admin_review_warnings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/readlite_surface"
                android:padding="12dp"
                android:textColor="@color/readlite_ink"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Tập và chương · chọn chương để xem nội dung, ảnh"
                android:textColor="@color/readlite_ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/admin_review_chapters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/admin_review_approve"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Duyệt và xuất bản"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/admin_review_changes"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Yêu cầu chỉnh sửa"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/admin_review_reject"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Từ chối"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
