<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chapter_reader_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/readlite_paper" android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/readlite_surface" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/chapter_reader_back_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:gravity="start|center_vertical" android:text="@string/reader_back"
            android:textAllCaps="false" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/reader_contents_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="48dp"
            android:text="@string/reader_contents" android:textAllCaps="false" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/reader_font_decrease_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="48dp" android:layout_height="48dp"
            android:contentDescription="@string/reader_font_decrease"
            android:minWidth="48dp" android:minHeight="48dp"
            android:text="A−" android:textAllCaps="false" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/reader_font_increase_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="48dp" android:layout_height="48dp"
            android:contentDescription="@string/reader_font_increase"
            android:minWidth="48dp" android:minHeight="48dp"
            android:text="A+" android:textAllCaps="false" />
        <com.google.android.material.button.MaterialButton android:id="@+id/reader_actions_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="48dp" android:layout_height="48dp" android:minWidth="48dp"
            android:padding="0dp" android:text="⋮" android:textSize="24sp" android:contentDescription="Tùy chọn đọc và dấu trang"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/readlite_surface" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingStart="22dp" android:paddingEnd="22dp"
        android:paddingBottom="8dp">
        <ProgressBar android:id="@+id/chapter_reader_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1"
            android:max="1000" android:progress="0" android:progressTint="@color/readlite_green"
            android:progressBackgroundTint="@color/readlite_line" />
        <TextView android:id="@+id/chapter_reader_progress_text"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:gravity="end"
            android:textColor="@color/readlite_muted" android:textSize="12sp" />
    </LinearLayout>

    <ScrollView android:id="@+id/chapter_reader_scroll"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="22dp" android:paddingTop="20dp"
            android:paddingEnd="22dp" android:paddingBottom="28dp">
            <TextView android:id="@+id/chapter_reader_status"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite" android:text="@string/chapter_loading"
                android:textColor="@color/readlite_muted" android:textSize="14sp" />
            <TextView android:id="@+id/chapter_reader_title"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:textColor="@color/readlite_ink"
                android:textSize="24sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chapter_previous_button"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp" android:layout_weight="1"
                    android:text="@string/chapter_previous" android:textAllCaps="false" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chapter_next_button"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" android:layout_weight="1"
                    android:text="@string/chapter_next" android:textAllCaps="false" />
            </LinearLayout>
            <LinearLayout android:id="@+id/chapter_reader_content"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="22dp" android:orientation="vertical" />
            <com.google.android.material.button.MaterialButton android:id="@+id/reader_add_bookmark_button"
                style="@style/Widget.ReadLite.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/bookmark_add_button"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/reader_bookmarks_button"
                style="@style/Widget.ReadLite.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/bookmark_list_title"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/chapter_comments_button"
                style="@style/Widget.ReadLite.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="Bình luận chương này"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="32dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chapter_previous_bottom_button"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp" android:layout_weight="1"
                    android:text="@string/chapter_previous" android:textAllCaps="false" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chapter_next_bottom_button"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" android:layout_weight="1"
                    android:text="@string/chapter_next" android:textAllCaps="false" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
