<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/story_detail_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/readlite_paper">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:paddingStart="12dp" android:paddingEnd="20dp" android:gravity="center_vertical">
        <com.google.android.material.button.MaterialButton android:id="@+id/story_detail_back_button" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:padding="12dp" app:icon="@drawable/ic_readlite_back" app:iconPadding="0dp" android:contentDescription="@string/action_back"/>
        <TextView style="@style/Widget.ReadLite.Label" android:layout_width="0dp" android:layout_weight="1" android:text="Chi tiết truyện" android:layout_marginStart="8dp"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="24dp">
        <TextView style="@style/Widget.ReadLite.Body" android:text="@string/story_detail_loading" android:id="@+id/story_detail_status" android:accessibilityLiveRegion="polite" android:layout_marginBottom="12dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top">
            <FrameLayout android:layout_width="135dp" android:layout_height="203dp" android:background="@drawable/bg_story_cover_placeholder">
                <ImageView android:id="@+id/story_detail_cover" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone" android:importantForAccessibility="no"/>
                <TextView android:id="@+id/story_detail_cover_placeholder" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp" android:gravity="center" android:textColor="#FFFFFF" android:textSize="16sp" android:fontFamily="serif"/>
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="18dp" android:orientation="vertical">
                <TextView style="@style/Widget.ReadLite.Title" android:text="" android:id="@+id/story_detail_title" android:textSize="21sp"/>
                <TextView style="@style/Widget.ReadLite.Body" android:text="" android:id="@+id/story_detail_author" android:layout_marginTop="12dp"/>
                <TextView style="@style/Widget.ReadLite.Body" android:text="Light novel" android:layout_marginTop="8dp"/>
                <TextView android:id="@+id/story_detail_lifecycle" style="@style/Widget.ReadLite.Body" android:text="Tiến hành: Đang ra" android:layout_marginTop="8dp" />
<TextView style="@style/Widget.ReadLite.Body" android:text="" android:id="@+id/story_detail_rating" android:layout_marginTop="8dp"/>
                <TextView style="@style/Widget.ReadLite.Body" android:text="" android:id="@+id/story_detail_genres" android:layout_marginTop="8dp" android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/story_detail_favorite" style="@style/Widget.ReadLite.Secondary" android:layout_width="match_parent" android:layout_height="52dp" android:text="@string/story_favorite_add" android:layout_marginTop="18dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/story_detail_follow" style="@style/Widget.ReadLite.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Theo dõi chương mới" android:layout_marginTop="8dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/story_detail_read_now" style="@style/Widget.ReadLite.Primary" android:layout_width="match_parent" android:layout_height="52dp" android:text="@string/story_detail_read_now" android:layout_marginTop="10dp" android:enabled="false"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/story_detail_comments" style="@style/Widget.ReadLite.Secondary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Bình luận" android:layout_marginEnd="6dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/story_detail_report" style="@style/Widget.ReadLite.Secondary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Báo cáo" android:layout_marginStart="6dp"/>
        </LinearLayout>
        <com.google.android.material.tabs.TabLayout android:id="@+id/story_detail_tabs" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="14dp" android:background="@color/readlite_paper" app:tabTextColor="@color/readlite_muted" app:tabSelectedTextColor="@color/readlite_taupe_dark" app:tabIndicatorColor="@color/readlite_taupe"/>
        <LinearLayout android:id="@+id/story_detail_overview" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="20dp">
            <TextView style="@style/Widget.ReadLite.Label" android:text="Giới thiệu" /><TextView style="@style/Widget.ReadLite.Body" android:text="" android:id="@+id/story_detail_summary" android:lineSpacingExtra="6dp" android:textSize="14sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/story_chapter_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="12dp" android:visibility="gone"/>
        <LinearLayout android:id="@+id/story_review_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="16dp" android:visibility="gone">
            <TextView android:id="@+id/story_review_summary" style="@style/Widget.ReadLite.Label" android:text="Đánh giá từ độc giả"/>
            <TextView android:id="@+id/story_review_own" style="@style/Widget.ReadLite.Body" android:visibility="gone" android:layout_marginTop="12dp" android:layout_marginBottom="12dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/story_review_write" style="@style/Widget.ReadLite.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Viết đánh giá"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/story_review_delete" style="@style/Widget.ReadLite.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Xóa đánh giá của tôi" android:visibility="gone"/>
            <TextView android:id="@+id/story_review_status" style="@style/Widget.ReadLite.Body" android:accessibilityLiveRegion="polite"/>
            <LinearLayout android:id="@+id/story_review_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/story_review_more" style="@style/Widget.ReadLite.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Xem thêm" android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout></ScrollView>
</LinearLayout>
