<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/catalog_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/readlite_paper" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="18dp">
    <TextView style="@style/Widget.ReadLite.Title" android:text="Khám phá truyện" />
    <TextView style="@style/Widget.ReadLite.Body" android:text="Tìm câu chuyện tiếp theo của bạn." android:layout_marginTop="5dp" android:layout_marginBottom="18dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical">
        <EditText android:id="@+id/catalog_search_input" style="@style/Widget.ReadLite.Field" android:layout_width="0dp" android:layout_weight="1" android:hint="Tìm truyện, tác giả…" android:inputType="text" android:imeOptions="actionSearch"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/catalog_search_button" android:layout_width="52dp" android:layout_height="52dp" android:layout_marginStart="8dp" android:minWidth="0dp" android:padding="14dp" android:contentDescription="Tìm truyện" app:icon="@drawable/ic_readlite_search" app:iconTint="@android:color/white" app:iconPadding="0dp" app:iconGravity="textStart"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/catalog_genre_input" style="@style/Widget.ReadLite.Field" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:hint="Thể loại" android:inputType="text" android:textSize="12sp" android:popupBackground="@color/readlite_surface" android:dropDownHeight="280dp"/>
        <Spinner android:id="@+id/catalog_sort_spinner" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="8dp" android:background="@drawable/bg_readlite_input" android:paddingStart="8dp" android:paddingEnd="8dp"/>
    </LinearLayout>
    <Spinner android:id="@+id/catalog_lifecycle_spinner" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/bg_readlite_input" android:paddingStart="8dp" android:paddingEnd="8dp" android:contentDescription="Lọc trạng thái tiến hành truyện" />
    <TextView style="@style/Widget.ReadLite.Body" android:text="@string/catalog_loading" android:id="@+id/catalog_status" android:accessibilityLiveRegion="polite" android:layout_marginTop="12dp" android:layout_marginBottom="10dp" android:textSize="12sp"/>
</LinearLayout>
<GridView android:id="@+id/catalog_story_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="12dp" android:clipToPadding="false" android:numColumns="2" android:horizontalSpacing="14dp" android:verticalSpacing="12dp" android:stretchMode="columnWidth" android:listSelector="@android:color/transparent"/>
<com.google.android.material.button.MaterialButton android:id="@+id/catalog_load_more_button" style="@style/Widget.ReadLite.Secondary" android:layout_width="match_parent" android:layout_height="52dp" android:text="@string/catalog_load_more" android:visibility="gone" android:layout_marginStart="20dp" android:layout_marginEnd="20dp"/>
<View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/readlite_line"/><com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/catalog_bottom_navigation" style="@style/Widget.ReadLite.Navigation" app:menu="@menu/catalog_bottom_menu"/></LinearLayout>
