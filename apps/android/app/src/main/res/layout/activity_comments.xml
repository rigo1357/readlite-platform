<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/comments_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/readlite_paper">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/comments_back" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="48dp" android:contentDescription="Quay lại" android:text="‹"/>
        <TextView android:id="@+id/comments_title" style="@style/Widget.ReadLite.Title" android:layout_width="0dp" android:layout_weight="1" android:text="Bình luận" android:textSize="20sp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/comments_refresh" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Tải lại"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:id="@+id/comments_parent" style="@style/Widget.ReadLite.Body" android:visibility="gone" android:layout_marginBottom="12dp"/>
            <TextView android:id="@+id/comments_status" style="@style/Widget.ReadLite.Body" android:accessibilityLiveRegion="polite"/>
            <LinearLayout android:id="@+id/comments_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/comments_more" style="@style/Widget.ReadLite.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Xem thêm" android:visibility="gone"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="12dp" android:background="@color/readlite_surface">
        <EditText android:id="@+id/comments_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="Viết bình luận…" android:contentDescription="Nội dung bình luận" android:inputType="textCapSentences|textMultiLine" android:minLines="1" android:maxLines="4" android:maxLength="5000" android:textColor="@color/readlite_ink" android:textColorHint="@color/readlite_muted"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/comments_send" style="@style/Widget.ReadLite.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Gửi bình luận"/>
    </LinearLayout>
</LinearLayout>
