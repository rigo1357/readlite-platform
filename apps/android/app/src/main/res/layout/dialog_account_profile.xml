<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">
        <TextView style="@style/Widget.ReadLite.Label" android:text="@string/profile_display_name_label" android:labelFor="@id/profile_display_name" />
        <EditText
            android:id="@+id/profile_display_name"
            style="@style/Widget.ReadLite.Field"
            android:hint="@string/profile_display_name_hint"
            android:inputType="textPersonName|textCapWords"
            android:singleLine="true"
            android:maxLength="100"
            android:autofillHints="name"
            android:imeOptions="actionNext"
            android:layout_marginBottom="16dp" />
        <TextView style="@style/Widget.ReadLite.Label" android:text="@string/profile_username_label" android:labelFor="@id/profile_username" />
        <EditText
            android:id="@+id/profile_username"
            style="@style/Widget.ReadLite.Field"
            android:hint="@string/profile_username_hint"
            android:inputType="textVisiblePassword"
            android:singleLine="true"
            android:maxLength="20"
            android:autofillHints="username"
            android:imeOptions="actionDone"
            android:layout_marginBottom="16dp" />
        <TextView style="@style/Widget.ReadLite.Label" android:text="@string/profile_email_label" android:labelFor="@id/profile_email" />
        <TextView
            android:id="@+id/profile_email"
            style="@style/Widget.ReadLite.Body"
            android:textIsSelectable="true"
            android:layout_marginTop="6dp" />
        <TextView
            style="@style/Widget.ReadLite.Body"
            android:text="@string/profile_email_readonly"
            android:textSize="12sp"
            android:layout_marginTop="6dp" />
        <TextView
            android:id="@+id/profile_message"
            style="@style/Widget.ReadLite.Body"
            android:accessibilityLiveRegion="polite"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp" />
    </LinearLayout>
</ScrollView>
